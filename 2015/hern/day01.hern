let data = read_file("../.input/01")
  .trim()
  .chars()
  .map(fn(c) {
    match c {
      "(" -> 1,
      ")" -> -1,
      _ -> 0
    }
  });

let a = array_sum(data);

fn find_neg(items) {
  let mut acc = 0;
  let mut idx = 0;

  for num in items {
    acc = acc + num;
    idx = idx + 1;

    if acc < 0 {
      return idx
    }
  };

  -1
}

let b = find_neg(data);

print("Day 1")
print("a: " <> tostring(a));
print("b: " <> tostring(b));
